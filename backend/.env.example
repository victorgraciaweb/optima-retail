# Postgres Database configuration
# Must match DB_USERNAME / DB_PASSWORD / DB_NAME in the root .env (docker-compose).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=optima_retail_db

# General settings
GLOBAL_PREFIX=api
CORS_ENABLED=true
PORT=3000

# Swagger settings
TITLE_SWAGGER=Optima Retail API
DESCRIPTION_SWAGGER=Operational incident panel API
VERSION_SWAGGER=1.0
ROUTE_SWAGGER=docs
